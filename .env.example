OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=

# Required. ZimZ refuses to serve any request (HTTP 503) unless both are set —
# every API route reaches the Gateway with operator.admin scope, so there is
# deliberately no unauthenticated mode.
ZIMZ_AUTH_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -base64 48
ZIMZ_SESSION_SECRET=

# Optional. Extra origins allowed to send POST/PATCH/DELETE, comma separated.
# The request's own Host is always allowed, so this is only needed when ZimZ is
# reached under a hostname different from the one the browser connects to.
ZIMZ_ALLOWED_ORIGINS=
